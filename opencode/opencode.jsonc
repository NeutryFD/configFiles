{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "google-vertex": {
      "settings": {
        "project": "{file:~/.config/opencode/secrets/vertex-project}",
        "location": "global"
      }
    }
  },
  "mcp": {
    "servers": {
      "engram": {
        "type": "local",
        "command": [
          "{env:HOME}/go/bin/engram",
          "mcp",
          "--tools=agent"
        ]
      },
      "prometheus": {
        "type": "local",
        "command": [
          "docker",
          "run",
          "--rm",
          "-i",
          "--network",
          "host",
          "-e",
          "PROMETHEUS_MCP_SERVER_PROMETHEUS_URL",
          "ghcr.io/tjhop/prometheus-mcp-server:v0.18.0"
        ],
        "environment": {
          "PROMETHEUS_MCP_SERVER_PROMETHEUS_URL": "http://127.0.0.1:9090"
        },
        "timeout": 30000,
        "disabled": true
      },
      "grafana": {
        "type": "local",
        "command": [
          "docker",
          "run",
          "--rm",
          "-i",
          "--network",
          "host",
          "-e",
          "GRAFANA_URL",
          "-e",
          "GRAFANA_SERVICE_ACCOUNT_TOKEN",
          "grafana/mcp-grafana",
          "-t",
          "stdio"
        ],
        "environment": {
          "GRAFANA_URL": "http://172.20.26.2:3000",
          "GRAFANA_SERVICE_ACCOUNT_TOKEN": "{file:~/.config/opencode/secrets/grafana-sa-token}"
        },
        "timeout": 30000,
        "disabled": true
      },
      "kubeflow": {
        "type": "local",
        "command": [
          "{env:HOME}/.local/bin/kubeflow-mcp",
          "serve",
          "--transport",
          "stdio",
          "--persona",
          "platform-admin"
        ],
        "environment": {
          "KUBECONFIG": "{env:HOME}/.kube/config-pro-tekniker"
        },
        "disabled": true
      },
      "affine": {
        "type": "remote",
        "url": "http://192.168.20.201:3010/api/workspaces/7cfe1110-462a-4fbd-badf-1cafe192d4a0/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {file:~/.config/opencode/secrets/affine-mcp-token}"
        },
        "disabled": true
      }
    }
  },
  "permission": {
    "external_directory": {
      "~/.config/opencode/**": "allow",
	  "~/workspace/sync/inbox/**": "allow"
    }
  },
  // Todos are off by default in V2; this enables the todo tool and sidebar list.
  "experimental": {
    "todo": true
  }
}
