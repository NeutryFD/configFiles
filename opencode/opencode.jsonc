{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "engram": {
        "type": "local",
        "command": [
          "/home/neutry/go/bin/engram",
          "mcp",
          "--tools=agent"
        ]
      },
      "prometheus": {
        "type": "local",
        "command": [
          "docker",
          "run",
          "--rm",
          "-i",
          "--network",
          "host",
          "-e",
          "PROMETHEUS_MCP_SERVER_PROMETHEUS_URL",
          "ghcr.io/tjhop/prometheus-mcp-server:v0.18.0"
        ],
        "environment": {
          "PROMETHEUS_MCP_SERVER_PROMETHEUS_URL": "http://127.0.0.1:9090"
        },
        "timeout": 30000,
        "disabled": true
      },
      "grafana": {
        "type": "local",
        "command": [
          "docker",
          "run",
          "--rm",
          "-i",
          "--network",
          "host",
          "-e",
          "GRAFANA_URL",
          "-e",
          "GRAFANA_SERVICE_ACCOUNT_TOKEN",
          "grafana/mcp-grafana",
          "-t",
          "stdio"
        ],
        "environment": {
          "GRAFANA_URL": "http://172.20.26.2:3000",
          "GRAFANA_SERVICE_ACCOUNT_TOKEN": "{file:~/.config/opencode/secrets/grafana-sa-token}"
        },
        "timeout": 30000,
        "disabled": true
      },
      "kubeflow": {
        "type": "local",
        "command": [
          "{env:HOME}/.local/bin/kubeflow-mcp",
          "serve",
          "--transport",
          "stdio",
          "--persona",
          "platform-admin"
        ],
        "environment": {
          "KUBECONFIG": "{env:HOME}/.kube/config-pro-tekniker"
        },
        "disabled": true
      }
    }
  },
  "permission": {
    "external_directory": {
      "~/.config/opencode/**": "allow",
	  "~/workspace/sync/inbox/**": "allow"
    }
  }
}
