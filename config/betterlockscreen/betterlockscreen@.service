[Unit]
Description = Lock screen when going to sleep/suspend
Before=sleep.target
Before=suspend.target

[Service]
User=%I
Type=simple
Environment=DISPLAY=:0
# ly stores the X cookie in /run/user/<uid>/lyxauth instead of ~/.Xauthority
ExecStart=/bin/sh -c 'a=/run/user/$$(id -u)/lyxauth; [ -f "$$a" ] || a="$$HOME/.Xauthority"; XAUTHORITY="$$a" exec /usr/local/bin/betterlockscreen --lock dim'
TimeoutSec=infinity
ExecStartPost=/usr/bin/sleep 1

[Install]
WantedBy=sleep.target
WantedBy=suspend.target
